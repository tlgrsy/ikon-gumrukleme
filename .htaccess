# İKON — temiz URL'ler (Apache / LiteSpeed)
Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Geliştirme ve kaynak dosyalarını gizle
  RewriteRule ^(tools|preview|\.github)(/|$) - [R=404,L]
  RewriteRule ^(README\.md|DEPLOY\.md|deploy\.sh)$ - [R=404,L]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L,QSA]

  # /sayfa.html -> /sayfa  (301, query string korunur)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  # /index -> /
  RewriteRule ^index/?$ / [R=301,L,QSA]

  # dizin olmayan yollarda sondaki eğik çizgiyi kaldır
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,QSA]

  # /sayfa -> sayfa.html (dahili)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# Basit güvenlik başlıkları
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
